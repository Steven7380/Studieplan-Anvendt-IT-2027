{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/editor",
      "rewrite": "/editor.html"
    },
    {
      "route": "/studieomtale/editor.html",
      "rewrite": "/editor.html"
    },
    {
      "route": "/emnebeskrivelser/editor.html",
